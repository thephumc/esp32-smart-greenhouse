# ============================================================================
# 8. NON-BLOCKING WEB SERVER & ENDPOINTS
# ============================================================================
def start_web_server():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('0.0.0.0', 80))
    s.listen(5)
    s.setblocking(False)
    return s

server_socket = start_web_server()

def handle_web_client():
    global system_mode, selected_plant_zone1, selected_plant_zone2, profile_zone1, profile_zone2, manual_fan_speed_pct
    try:
        cl, addr = server_socket.accept()
    except OSError:
        return

    cl.settimeout(1.0)
    try:
        request = cl.recv(1024).decode('utf-8')
        if not request:
            cl.close()
            return

        lines = request.split('\r\n')
        req_line = lines[0]
        method, path, _ = req_line.split(' ')

        if method == "GET" and path == "/":
            cl.send('HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\n\r\n')
            cl.sendall(HTML_WEB_PAGE.encode('utf-8'))

        elif method == "GET" and path == "/api/status":
            payload = {
                "mode": system_mode,
                "temperature": dht_temperature,
                "humidity": dht_humidity,
                "soil1": zone1.soil_pct,
                "soil2": zone2.soil_pct,
                "fan": fan_speed_pct,
                "pump1": zone1.is_pump_on(),
                "pump2": zone2.is_pump_on(),
                "zone1_state": zone1.state,
                "zone2_state": zone2.state,
                "soil1_valid": zone1.soil_valid,
                "soil2_valid": zone2.soil_valid,
                "z1_plant": selected_plant_zone1,
                "z2_plant": selected_plant_zone2,
                "z1_targets": {
                    "soil_start": profile_zone1["soil_start"],
                    "soil_stop": profile_zone1["soil_stop"],
                    "fan_temp_start": profile_zone1["fan_temp_start"]
                },
                "z2_targets": {
                    "soil_start": profile_zone2["soil_start"],
                    "soil_stop": profile_zone2["soil_stop"],
                    "fan_temp_start": profile_zone2["fan_temp_start"]
                }
            }
            cl.send('HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n')
            cl.send(json.dumps(payload))

        elif method == "POST" and path == "/api/mode":
            body = request.split('\r\n\r\n')[1]
            data = json.loads(body)
            system_mode = data.get("mode", "AUTO")
            zone1.set_pump(False)
            zone2.set_pump(False)
            cl.send('HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{"status":"OK"}')

        elif method == "POST" and path == "/api/plant":
            body = request.split('\r\n\r\n')[1]
            data = json.loads(body)
            z_num = data.get("zone", 1)
            p_name = data.get("plant", "default")
            
            if z_num == 1:
                selected_plant_zone1 = p_name
                profile_zone1 = get_plant_profile(p_name)
                print(f"[API] Zone 1 Plant updated to: {selected_plant_zone1}")
            else:
                selected_plant_zone2 = p_name
                profile_zone2 = get_plant_profile(p_name)
                print(f"[API] Zone 2 Plant updated to: {selected_plant_zone2}")
                
            cl.send('HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{"status":"OK"}')

        elif method == "POST" and path == "/api/fan":
            body = request.split('\r\n\r\n')[1]
            data = json.loads(body)
            manual_fan_speed_pct = data.get("speed", 0)
            cl.send('HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{"status":"OK"}')

        elif method == "POST" and path == "/api/pump":
            body = request.split('\r\n\r\n')[1]
            data = json.loads(body)
            pump_num = data.get("pump")
            action = data.get("action")
            
            if system_mode == "MANUAL":
                now = time.ticks_ms()
                if pump_num == 1:
                    zone1.set_pump(action == "ON")
                    zone1.manual_start_time = now
                elif pump_num == 2:
                    zone2.set_pump(action == "ON")
                    zone2.manual_start_time = now
            cl.send('HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{"status":"OK"}')

        else:
            cl.send('HTTP/1.1 404 Not Found\r\n\r\n')

    except Exception:
        pass
    finally:
        cl.close()

# ============================================================================
# 9. MAIN LOOP (VÒNG LẶP CHÍNH)
# ============================================================================
print("[INFO] ESP32 Smart Greenhouse Dual-Zone Running...")
gc.collect()

while True:
    try:
        update_dht_sensor()

        if system_mode == "AUTO":
            zone1.update_auto(profile_zone1, zone2.is_pump_on())
            zone2.update_auto(profile_zone2, zone1.is_pump_on())
        else:
            zone1.read_sensor()
            zone2.read_sensor()

        update_air_control()
        enforce_pump_safety()
        handle_web_client()
        
        gc.collect()
        time.sleep_ms(20)

    except Exception as err:
        print("[CRITICAL ERROR in Main Loop]:", err)
        time.sleep_ms(100)

