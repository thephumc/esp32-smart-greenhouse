# 5. IRRIGATION ZONE CLASS
# ============================================================================
class IrrigationZone:
    def __init__(self, zone_id, adc_pin, pump_pin, dry_adc, wet_adc):
        self.zone_id = zone_id
        self.adc = adc_pin
        self.pump_pin = pump_pin
        self.dry_adc = dry_adc
        self.wet_adc = wet_adc
        
        self.state = "IDLE"
        self.soil_pct = None
        self.soil_valid = False
        self.raw_adc = 0
        
        self.pulse_count = 0
        self.state_timer = time.ticks_ms()
        self.manual_start_time = 0
        
    def set_pump(self, state_bool):
        self.pump_pin.value(1 if state_bool else 0)

    def is_pump_on(self):
        return self.pump_pin.value() == 1

    def read_sensor(self):
        total = 0
        samples = 5
        for _ in range(samples):
            total += self.adc.read()
            time.sleep_ms(2)
        raw = total // samples
        self.raw_adc = raw

        if raw < ADC_MIN_VALID or raw > ADC_MAX_VALID:
            self.soil_valid = False
            self.soil_pct = None
            return False
        
        pct = int((self.dry_adc - raw) * 100 / (self.dry_adc - self.wet_adc))
        if pct < 0: pct = 0
        if pct > 100: pct = 100
        
        self.soil_pct = pct
        self.soil_valid = True
        return True

    def update_auto(self, profile, other_zone_pump_active):
        now = time.ticks_ms()
        
        if not self.read_sensor():
            if self.state != "ERROR":
                print(f"[ERROR] Zone {self.zone_id} Sensor Invalid! ADC: {self.raw_adc}")
            self.state = "ERROR"
            self.set_pump(False)
            return

        if self.state == "ERROR" and self.soil_valid:
            self.state = "IDLE"

        if self.state == "IDLE":
            self.set_pump(False)
            if self.soil_pct < profile["soil_start"]:
                print(f"[ZONE {self.zone_id}] Dry detected ({self.soil_pct}% < {profile['soil_start']}%). Requesting WATERING.")
                self.pulse_count = 0
                self.state = "WAITING_PUMP"

        elif self.state == "WAITING_PUMP":
            if not ALLOW_DUAL_PUMP and other_zone_pump_active:
                return
            
            self.pulse_count += 1
            print(f"[ZONE {self.zone_id}] Pulse {self.pulse_count}/{profile['max_pulses']} Starting...")
            self.set_pump(True)
            self.state_timer = now
            self.state = "WATERING"

        elif self.state == "WATERING":
            if time.ticks_diff(now, self.state_timer) >= profile["pulse_ms"]:
                self.set_pump(False)
                print(f"[ZONE {self.zone_id}] Pulse finished. SOAKING...")
                self.state_timer = now
                self.state = "SOAKING"

        elif self.state == "SOAKING":
            self.set_pump(False)
            if time.ticks_diff(now, self.state_timer) >= profile["soak_ms"]:
                print(f"[ZONE {self.zone_id}] Soaking done. RECHECKING...")
                self.state = "RECHECK"

        elif self.state == "RECHECK":
            self.read_sensor()
            if self.soil_valid and self.soil_pct >= profile["soil_stop"]:
                print(f"[ZONE {self.zone_id}] Moisture satisfied. Going to COMPLETE.")
                self.state_timer = now
                self.state = "COMPLETE"
            elif self.pulse_count >= profile["max_pulses"]:
                print(f"[ZONE {self.zone_id}] Max pulses reached. Going to COMPLETE.")
                self.state_timer = now
                self.state = "COMPLETE"
            else:
                self.state = "WAITING_PUMP"

        elif self.state == "COMPLETE":
            self.set_pump(False)
            self.state = "COOLDOWN"
            self.state_timer = now

        elif self.state == "COOLDOWN":
            self.set_pump(False)
            if time.ticks_diff(now, self.state_timer) >= profile["cooldown_ms"]:
                print(f"[ZONE {self.zone_id}] Cooldown finished. Back to IDLE.")
                self.state = "IDLE"

