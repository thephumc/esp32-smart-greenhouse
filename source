# 6. SYSTEM STATE & DUAL ZONE PROFILE MANAGEMENT
# ============================================================================
system_mode = "AUTO"

# Cấu hình 2 cây trồng riêng biệt cho Zone 1 và Zone 2
selected_plant_zone1 = "default"
profile_zone1 = DEFAULT_PROFILE.copy()

selected_plant_zone2 = "default"
profile_zone2 = DEFAULT_PROFILE.copy()

dht_temperature = None
dht_humidity = None
dht_valid = False
last_dht_read_time = 0

fan_speed_pct = 0
manual_fan_speed_pct = 0

def update_dht_sensor():
    global dht_temperature, dht_humidity, dht_valid, last_dht_read_time
    now = time.ticks_ms()
    if time.ticks_diff(now, last_dht_read_time) >= DHT_READ_INTERVAL_MS:
        last_dht_read_time = now
        try:
            dht_sensor.measure()
            dht_temperature = round(dht_sensor.temperature(), 1)
            dht_humidity = round(dht_sensor.humidity(), 1)
            dht_valid = True
        except Exception:
            dht_valid = False
            dht_temperature = None
            dht_humidity = None

def set_fan_duty(percent):
    global fan_speed_pct
    pct = max(0, min(100, percent))
    fan_speed_pct = pct
    duty_val = int(pct * 1023 / 100)
    fan_pwm.duty(duty_val)

def update_air_control():
    """Điều khiển quạt Tuyến tính (Proportional) - Sửa triệt để lỗi kẹt 70%-100%"""
    global fan_speed_pct
    if system_mode == "MANUAL":
        set_fan_duty(manual_fan_speed_pct)
        return

    if not dht_valid or dht_temperature is None:
        set_fan_duty(0)
        return

    # Lấy ngưỡng an toàn nhất cho cả 2 vùng cây trồng
    t_start = min(profile_zone1["fan_temp_start"], profile_zone2["fan_temp_start"])
    t_stop = min(profile_zone1["fan_temp_stop"], profile_zone2["fan_temp_stop"])
    rh_high = min(profile_zone1["fan_rh_high"], profile_zone2["fan_rh_high"])

    # Tính toán tốc độ tuyến tính chính xác theo nhiệt độ thực tế
    if dht_temperature >= t_start:
        target_speed = 100
    elif dht_temperature <= t_stop:
        target_speed = 0
    else:
        # Tăng dần tốc độ quạt theo khoảng chênh lệch nhiệt độ
        target_speed = int((dht_temperature - t_stop) / (t_start - t_stop) * 100)

    # Ưu tiên thông gió nếu độ ẩm không khí vượt ngưỡng an toàn
    if dht_humidity is not None and dht_humidity >= rh_high:
        target_speed = max(target_speed, 70)

    set_fan_duty(target_speed)

def enforce_pump_safety():
    now = time.ticks_ms()
    if system_mode == "MANUAL":
        if zone1.is_pump_on() and time.ticks_diff(now, zone1.manual_start_time) > MANUAL_PUMP_MAX_ON_MS:
            print("[SAFETY] Zone 1 Manual timeout! Forcing OFF.")
            zone1.set_pump(False)
            
        if zone2.is_pump_on() and time.ticks_diff(now, zone2.manual_start_time) > MANUAL_PUMP_MAX_ON_MS:
            print("[SAFETY] Zone 2 Manual timeout! Forcing OFF.")
            zone2.set_pump(False)

    if not ALLOW_DUAL_PUMP:
        if zone1.is_pump_on() and zone2.is_pump_on():
            print("[SAFETY DUAL PUMP] Both pumps active! Force stopping Pump 2.")
            zone2.set_pump(False)

